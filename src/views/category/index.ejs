<%- include("../partials/header", { title }) %>
<%- include("../partials/navbar") %>
        <main class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
            <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[.2em] text-stone-500">Organise</p>
                    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Categories</h1>
                    <p class="mt-2 text-sm text-stone-500">Keep your content grouped and easy to find.</p>
                </div><a href="/category/create"
                    class="inline-flex w-fit rounded-xl bg-stone-900 px-4 py-3 text-sm font-medium text-white hover:bg-stone-700">Create
                    category +</a>
            </div>
            <% if (!categories.length) { %>
                <div
                    class="mt-8 rounded-2xl border border-dashed border-stone-300 bg-white p-12 text-center text-sm text-stone-500">
                    No categories found. <a class="font-medium text-stone-900 underline" href="/category/create">Create
                        one</a>.</div>
                <% } else { %>
                    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                        <% categories.forEach(category=> { %><article
                                class="overflow-hidden rounded-2xl border border-stone-200 bg-white"><img
                                    class="h-48 w-full object-cover" src="<%= category.imageurl %>"
                                    alt="<%= category.name %>" onerror="this.style.display='none'">
                                <div class="p-5">
                                    <h2 class="font-semibold">
                                        <%= category.name %>
                                    </h2>
                                    <p class="mt-2 min-h-12 text-sm leading-6 text-stone-500">
                                        <%= category.description %>
                                    </p>
                                    <div class="mt-5 flex flex-wrap items-center gap-3 text-sm"><a
                                            class="font-medium underline underline-offset-4"
                                            href="/category/<%= category.id %>">View</a><a
                                            class="text-stone-600 underline underline-offset-4"
                                            href="/category/<%= category.id %>/edit">Edit</a>
                                        <form action="/category/<%= category.id %>?_method=DELETE" method="POST"
                                            onsubmit="return confirm('Delete this category?')"><button
                                                class="text-red-600 underline underline-offset-4">Delete</button></form>
                                    </div>
                                </div>
                            </article>
                            <% }) %>
                    </div>
                    <% } %>
        </main><%- include("../partials/footer") %>