<%- include("../partials/header", { title }) %><%- include("../partials/navbar") %>
<main class="mx-auto max-w-7xl px-5 py-12 lg:px-8"><a href="/category" class="text-sm text-stone-500 hover:text-stone-900">← All categories</a><section class="mt-6 grid gap-8 md:grid-cols-[.9fr_1.1fr] md:items-center"><img class="max-h-[420px] w-full rounded-3xl object-cover" src="<%= category.imageurl %>" alt="<%= category.name %>"><div><p class="text-xs font-semibold uppercase tracking-[.2em] text-stone-500">Category</p><h1 class="mt-3 text-4xl font-semibold tracking-tight"><%= category.name %></h1><p class="mt-4 max-w-xl leading-7 text-stone-600"><%= category.description %></p><a href="/category/<%= category.id %>/edit" class="mt-6 inline-flex rounded-xl border border-stone-300 px-4 py-3 text-sm font-medium hover:bg-white">Edit category</a></div></section><section class="mt-16"><h2 class="text-2xl font-semibold tracking-tight">Published content</h2><% if(!contents.length){ %><p class="mt-5 rounded-2xl border border-dashed border-stone-300 bg-white p-8 text-sm text-stone-500">No published content in this category yet.</p><% } else { %><div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><% contents.forEach(item => { %><article class="overflow-hidden rounded-2xl border border-stone-200 bg-white"><% if(item.thumbnail){ %><img class="h-44 w-full object-cover" src="<%= item.thumbnail %>" alt="<%= item.title %>"><% } %><div class="p-5"><h3 class="font-semibold"><%= item.title %></h3><p class="mt-2 text-sm leading-6 text-stone-500"><%= item.description %></p><a class="mt-4 inline-block text-sm font-medium underline underline-offset-4" href="/content/<%= item.id %>">Read article</a></div></article><% }) %></div><% } %></section></main><%- include("../partials/footer") %>
