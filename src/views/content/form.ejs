<%- include("../partials/header", { title }) %>
<%- include("../partials/navbar") %>
        <main class="mx-auto max-w-3xl px-5 py-12"><a href="/content"
                class="text-sm text-stone-500 hover:text-stone-900">← Back to content</a>
            <section class="mt-6 rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                <p class="text-xs font-semibold uppercase tracking-[.2em] text-stone-500">Content editor</p>
                <h1 class="mt-2 text-2xl font-semibold tracking-tight">
                    <%= title %>
                </h1>
                <p class="mt-2 text-sm text-stone-500">Write, organise and publish your content.</p>
                <% if(error){ %>
                    <p class="mt-5 rounded-xl bg-red-50 p-3 text-sm text-red-700">
                        <%= error %>
                    </p>
                    <% } %>
                        <% if(!categories.length){ %>
                            <p class="mt-5 rounded-xl bg-amber-50 p-3 text-sm text-amber-800">Create a category before
                                adding content. <a class="font-semibold underline" href="/category/create">Create
                                    category</a>.</p>
                            <% } %>
                                <form class="mt-7 space-y-5" action="<%= formAction %>" method="POST">
                                    <div><label class="mb-2 block text-sm font-medium">Category</label><select
                                            class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none focus:border-stone-900 focus:ring-2 focus:ring-stone-200"
                                            name="categoryId" required>
                                            <option value="">Select category</option>
                                            <% categories.forEach(category=> { %><option value="<%= category.id %>"
                                                    <%=item.categoryId===category.id ? "selected" : "" %>><%=
                                                        category.name %>
                                                </option>
                                                <% }) %>
                                        </select></div>
                                    <div><label class="mb-2 block text-sm font-medium">Title</label><input
                                            class="w-full rounded-xl border border-stone-300 px-4 py-3 text-sm outline-none focus:border-stone-900 focus:ring-2 focus:ring-stone-200"
                                            name="title" value="<%= item.title || '' %>" required minlength="3"></div>
                                    <div><label class="mb-2 block text-sm font-medium">Short
                                            description</label><textarea
                                            class="w-full rounded-xl border border-stone-300 px-4 py-3 text-sm outline-none focus:border-stone-900 focus:ring-2 focus:ring-stone-200"
                                            name="description" rows="3" required
                                            minlength="3"><%= item.description || '' %></textarea></div>
                                    <div><label class="mb-2 block text-sm font-medium">Content body</label><textarea
                                            class="w-full rounded-xl border border-stone-300 px-4 py-3 text-sm leading-6 outline-none focus:border-stone-900 focus:ring-2 focus:ring-stone-200"
                                            name="body" rows="9" required
                                            minlength="10"><%= item.body || '' %></textarea></div>
                                    <div><label class="mb-2 block text-sm font-medium">Thumbnail URL <span
                                                class="font-normal text-stone-400">(optional)</span></label><input
                                            class="w-full rounded-xl border border-stone-300 px-4 py-3 text-sm outline-none focus:border-stone-900 focus:ring-2 focus:ring-stone-200"
                                            type="url" name="thumbnail" value="<%= item.thumbnail || '' %>"
                                            placeholder="https://example.com/image.jpg"></div>
                                    <div><label class="mb-2 block text-sm font-medium">Status</label><select
                                            class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none focus:border-stone-900 focus:ring-2 focus:ring-stone-200"
                                            name="status">
                                            <option value="draft" <%=(item.status || "draft" )==="draft" ? "selected"
                                                : "" %>>Draft</option>
                                            <option value="published" <%=item.status==="published" ? "selected" : "" %>
                                                >Published</option>
                                        </select></div>
                                    <div class="flex gap-3 pt-2"><button
                                            class="rounded-xl bg-stone-900 px-5 py-3 text-sm font-medium text-white hover:bg-stone-700"
                                            <%=!categories.length ? "disabled" : "" %>><%= submitLabel %></button><a
                                            href="/content"
                                            class="rounded-xl border border-stone-300 px-5 py-3 text-sm font-medium hover:bg-stone-50">Cancel</a>
                                    </div>
                                </form>
            </section>
        </main><%- include("../partials/footer") %>