<%- include("../partials/header", { title }) %>
<%- include("../partials/navbar") %>
        <main class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
            <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[.2em] text-stone-500">Publish</p>
                    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Content</h1>
                    <p class="mt-2 text-sm text-stone-500">Create and manage your articles.</p>
                </div><a href="/content/create"
                    class="inline-flex w-fit rounded-xl bg-stone-900 px-4 py-3 text-sm font-medium text-white hover:bg-stone-700">Create
                    content +</a>
            </div>
            <% if(!contents.length){ %>
                <div
                    class="mt-8 rounded-2xl border border-dashed border-stone-300 bg-white p-12 text-center text-sm text-stone-500">
                    No content found. <a class="font-medium text-stone-900 underline" href="/content/create">Create your
                        first article</a>.</div>
                <% } else { %>
                    <div class="mt-8 overflow-hidden rounded-2xl border border-stone-200 bg-white">
                        <div class="overflow-x-auto">
                            <table class="w-full min-w-[760px] text-left text-sm">
                                <thead
                                    class="border-b border-stone-200 bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
                                    <tr>
                                        <th class="px-5 py-4 font-medium">Content</th>
                                        <th class="px-5 py-4 font-medium">Category</th>
                                        <th class="px-5 py-4 font-medium">Status</th>
                                        <th class="px-5 py-4 font-medium">Updated</th>
                                        <th class="px-5 py-4 text-right font-medium">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-stone-100">
                                    <% contents.slice().reverse().forEach(item=> { %><tr>
                                            <td class="px-5 py-4">
                                                <div class="flex items-center gap-3">
                                                    <% if(item.thumbnail){ %><img
                                                            class="h-12 w-14 rounded-lg object-cover"
                                                            src="<%= item.thumbnail %>" alt="">
                                                        <% } else { %>
                                                            <div
                                                                class="grid h-12 w-14 place-items-center rounded-lg bg-stone-100 text-xs font-semibold text-stone-500">
                                                                A.</div>
                                                            <% } %>
                                                                <div>
                                                                    <p class="font-medium">
                                                                        <%= item.title %>
                                                                    </p>
                                                                    <p
                                                                        class="mt-1 max-w-xs truncate text-xs text-stone-500">
                                                                        <%= item.description %>
                                                                    </p>
                                                                </div>
                                                </div>
                                            </td>
                                            <td class="px-5 py-4 text-stone-600">
                                                <%= categoryMap[item.categoryId]?.name || "Unknown" %>
                                            </td>
                                            <td class="px-5 py-4"><span
                                                    class="rounded-full px-2.5 py-1 text-xs font-medium <%= item.status === 'published' ? 'bg-emerald-50 text-emerald-700' : 'bg-stone-100 text-stone-600' %>">
                                                    <%= item.status %>
                                                </span></td>
                                            <td class="px-5 py-4 text-xs text-stone-500">
                                                <%= formatDate(item.updatedAt) %>
                                            </td>
                                            <td class="px-5 py-4">
                                                <div class="flex justify-end gap-3">
                                                    <% if(item.status==='published' ){ %><a
                                                            class="font-medium underline underline-offset-4"
                                                            href="/content/<%= item.id %>">View</a>
                                                        <% } %><a class="text-stone-600 underline underline-offset-4"
                                                                href="/content/<%= item.id %>/edit">Edit</a>
                                                            <form action="/content/<%= item.id %>?_method=DELETE"
                                                                method="POST"
                                                                onsubmit="return confirm('Delete this content?')">
                                                                <button
                                                                    class="text-red-600 underline underline-offset-4">Delete</button>
                                                            </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <% } %>
        </main><%- include("../partials/footer") %>