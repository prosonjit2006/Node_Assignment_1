<%- include("../partials/header", { title }) %><%- include("../partials/navbar") %>
<main class="mx-auto max-w-3xl px-5 py-12"><a href="/category/<%= category.id %>" class="text-sm text-stone-500 hover:text-stone-900">← <%= category.name %></a><article class="mt-8"><% if(item.thumbnail){ %><img class="max-h-[440px] w-full rounded-3xl object-cover" src="<%= item.thumbnail %>" alt="<%= item.title %>"><% } %><p class="mt-8 text-xs font-semibold uppercase tracking-[.2em] text-stone-500"><%= category.name %></p><h1 class="mt-3 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl"><%= item.title %></h1><p class="mt-5 text-lg leading-8 text-stone-600"><%= item.description %></p><p class="mt-5 text-xs text-stone-400">Updated <%= formatDate(item.updatedAt) %></p><div class="my-8 border-t border-stone-200"></div><div class="whitespace-pre-wrap text-base leading-8 text-stone-700"><%= item.body %></div></article></main><%- include("../partials/footer") %>
