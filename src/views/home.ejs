<%- include("./partials/header", { title }) %><%- include("./partials/navbar") %>
<main class="mx-auto max-w-7xl px-5 lg:px-8">
  <section class="grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.25fr_.75fr] lg:items-center">
    <div><p class="text-xs font-semibold uppercase tracking-[.22em] text-stone-500">A home for your ideas</p><h1 class="mt-5 max-w-2xl text-5xl font-semibold leading-[1.08] tracking-tight sm:text-6xl">Make space for <span class="text-stone-400">good content.</span></h1><p class="mt-6 max-w-xl text-base leading-7 text-stone-600">Create categories, shape your stories and keep everything organised in one calm workspace.</p><div class="mt-8 flex flex-wrap gap-3"><a href="/category" class="rounded-xl bg-stone-900 px-5 py-3 text-sm font-medium text-white hover:bg-stone-700">Explore categories</a><a href="/content" class="rounded-xl border border-stone-300 bg-white px-5 py-3 text-sm font-medium hover:bg-stone-100">Manage content</a></div></div>
    <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm"><div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-stone-100 text-xl">✳</div><p class="mt-8 text-sm font-medium text-stone-500">YOUR CREATIVE WORKSPACE</p><p class="mt-2 text-2xl font-semibold tracking-tight">Simple by design.</p><p class="mt-3 text-sm leading-6 text-stone-600">Less clutter, clear structure and everything you need to publish with confidence.</p><div class="mt-8 grid grid-cols-2 gap-3"><div class="rounded-2xl bg-stone-50 p-4"><p class="text-2xl font-semibold"><%= categories.length %></p><p class="mt-1 text-xs text-stone-500">Categories</p></div><div class="rounded-2xl bg-stone-50 p-4"><p class="text-2xl font-semibold"><%= contents.length %></p><p class="mt-1 text-xs text-stone-500">Published posts</p></div></div></div>
  </section>
  <section class="pb-14"><div class="mb-6 flex items-end justify-between"><div><p class="text-xs font-semibold uppercase tracking-[.2em] text-stone-500">Browse</p><h2 class="mt-2 text-2xl font-semibold tracking-tight">Categories</h2></div><a href="/category" class="text-sm font-medium text-stone-600 hover:text-stone-900">View all →</a></div>
  <% if (!categories.length) { %><div class="rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-sm text-stone-500">No categories yet. <a class="font-medium text-stone-900 underline" href="/category/create">Create your first category</a>.</div><% } else { %><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><% categories.slice(0,6).forEach(category => { %><a href="/category/<%= category.id %>" class="group overflow-hidden rounded-2xl border border-stone-200 bg-white transition hover:-translate-y-1 hover:shadow-md"><img class="h-48 w-full object-cover" src="<%= category.imageurl %>" alt="<%= category.name %>" onerror="this.style.display='none'"><div class="p-5"><h3 class="font-semibold"><%= category.name %></h3><p class="mt-2 line-clamp-2 text-sm leading-6 text-stone-500"><%= category.description %></p></div></a><% }) %></div><% } %></section>
  <section class="pb-8"><div class="mb-6 flex items-end justify-between"><div><p class="text-xs font-semibold uppercase tracking-[.2em] text-stone-500">Recently published</p><h2 class="mt-2 text-2xl font-semibold tracking-tight">Latest content</h2></div><a href="/content" class="text-sm font-medium text-stone-600 hover:text-stone-900">Manage content →</a></div>
  <% if (!contents.length) { %><div class="rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-sm text-stone-500">Nothing published yet.</div><% } else { %><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><% contents.forEach(item => { %><article class="overflow-hidden rounded-2xl border border-stone-200 bg-white"><% if(item.thumbnail){ %><img class="h-44 w-full object-cover" src="<%= item.thumbnail %>" alt="<%= item.title %>" onerror="this.style.display='none'"><% } %><div class="p-5"><span class="text-xs font-medium text-emerald-700">Published</span><h3 class="mt-2 text-lg font-semibold"><%= item.title %></h3><p class="mt-2 line-clamp-2 text-sm leading-6 text-stone-500"><%= item.description %></p><a class="mt-5 inline-block text-sm font-medium underline underline-offset-4" href="/content/<%= item.id %>">Read article</a></div></article><% }) %></div><% } %></section>
</main><%- include("./partials/footer") %>
