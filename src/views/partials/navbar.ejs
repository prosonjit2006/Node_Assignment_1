<header
  class="sticky top-0 z-30 border-b border-stone-200/80 bg-white/90 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 lg:px-8"
  >
    <a href="/" class="text-xl font-semibold tracking-tight"
      >Artify<span class="text-stone-400">.</span></a
    >
    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href="/"
        class="rounded-lg px-3 py-2 text-sm <%= currentPath === '/' ? 'bg-stone-100 font-medium' : 'text-stone-600 hover:bg-stone-100' %>"
        >Home</a
      >
      <a
        href="/category"
        class="rounded-lg px-3 py-2 text-sm <%= currentPath.startsWith('/category') ? 'bg-stone-100 font-medium' : 'text-stone-600 hover:bg-stone-100' %>"
        >Categories</a
      >
      <a
        href="/content"
        class="rounded-lg px-3 py-2 text-sm <%= currentPath.startsWith('/content') ? 'bg-stone-100 font-medium' : 'text-stone-600 hover:bg-stone-100' %>"
        >Content</a
      >
    </div>
    <a
      href="/content/create"
      class="hidden rounded-xl bg-stone-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-stone-700 sm:inline-flex"
      >New content <span class="ml-2">+</span></a
    >
  </nav>
</header>
